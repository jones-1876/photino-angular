<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Debug keeps the console window so Photino/ng-serve logs are visible.
         Release hides it so the app looks like a normal desktop app. -->
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <OutputType Condition="'$(Configuration)' != 'Debug'">WinExe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GimxBackend</RootNamespace>
    <AssemblyName>GimxBackend</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <AngularProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\FrontEnd'))</AngularProjectDir>
    <!--
      Release embeds the whole Angular bundle into GimxBackend.dll, so the published
      app is just the executable plus its assemblies - no loose UI files on disk.
      PhotinoServer reads them through a ManifestEmbeddedFileProvider, which needs this
      manifest. Debug never serves static files (the window points at `ng serve`), so
      leaving it off there avoids the package's "no EmbeddedResource items" warning.
    -->
    <GenerateEmbeddedFilesManifest Condition="'$(Configuration)' != 'Debug'">true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Photino.NET.Server" Version="4.0.12" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- wwwroot is generated by the Angular build; never treat it as source or ship it loose. -->
    <Compile Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
  </ItemGroup>

  <!--
    Release builds the Angular app, then embeds its output.

    The re-glob is required: MSBuild evaluates item globs before any target runs, so files
    the Exec below just created are otherwise invisible to this same build. The Link metadata
    is what puts them under "Resources/wwwroot" in the generated manifest, which is the path
    PhotinoServer's ManifestEmbeddedFileProvider looks under (Resources/<webRootFolder>).

    BeforeTargets must include _CalculateEmbeddedFilesManifestInputs: that target is prepended
    to PrepareResourceNamesDependsOn, so it runs before AssignTargetPaths and would otherwise
    hash an EmbeddedResource set that does not yet contain the Angular output.

    Only the npm steps honour SkipAngularBuild; the embedding always runs in Release so that a
    -p:SkipAngularBuild=true rebuild still packages whatever is already in wwwroot.
  -->
  <Target Name="EmbedAngularBuild"
          BeforeTargets="_CalculateEmbeddedFilesManifestInputs;AssignTargetPaths"
          Condition="'$(Configuration)' != 'Debug'">
    <Exec Command="npm ci" WorkingDirectory="$(AngularProjectDir)"
          Condition="'$(SkipAngularBuild)' != 'true' and !Exists('$(AngularProjectDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(AngularProjectDir)"
          Condition="'$(SkipAngularBuild)' != 'true'" />

    <ItemGroup>
      <AngularAsset Include="wwwroot\**" />
      <EmbeddedResource Include="@(AngularAsset)"
                        Link="Resources\wwwroot\%(AngularAsset.RecursiveDir)%(AngularAsset.Filename)%(AngularAsset.Extension)" />
    </ItemGroup>

    <Error Condition="'@(AngularAsset->Count())' == '0'"
           Text="wwwroot is empty - nothing to embed. Run `npm run build` in $(AngularProjectDir), or drop -p:SkipAngularBuild=true." />
  </Target>

</Project>
